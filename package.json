{
  "name": "polish-academic-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "lint": "oxlint src/",
    "lint:fix": "oxlint src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test tests/tool-error-handling.test.ts",
    "eval": "python scripts/eval/evaluator.py",
    "eval:rq1": "python scripts/eval/evaluator.py --rq RQ1",
    "eval:rq2": "python scripts/eval/evaluator.py --rq RQ2",
    "eval:rq3": "python scripts/eval/evaluator.py --rq RQ3",
    "eval:local": "python scripts/eval/evaluator.py --url http://localhost:8787/mcp",
    "eval:remote": "python scripts/eval/evaluator.py --url https://polish-academic-mcp.kolpol25.workers.dev/mcp",
    "eval:summary": "python scripts/eval/evaluator.py --summary",
    "eval:export": "python scripts/eval/evaluator.py --export-json",
    "eval:llm": "python scripts/eval/evaluator.py --model anthropic/claude-3.5-sonnet",
    "eval:llm:rq1": "python scripts/eval/evaluator.py --rq RQ1 --model anthropic/claude-3.5-sonnet",
    "eval:llm:rq2": "python scripts/eval/evaluator.py --rq RQ2 --model anthropic/claude-3.5-sonnet",
    "eval:llm:rq3": "python scripts/eval/evaluator.py --rq RQ3 --model anthropic/claude-3.5-sonnet",
    "eval:llm:claude": "python scripts/eval/evaluator.py --model anthropic/claude-3.5-sonnet",
    "eval:llm:claude:rq1": "python scripts/eval/evaluator.py --rq RQ1 --model anthropic/claude-3.5-sonnet",
    "eval:llm:claude:rq2": "python scripts/eval/evaluator.py --rq RQ2 --model anthropic/claude-3.5-sonnet",
    "eval:llm:claude:rq3": "python scripts/eval/evaluator.py --rq RQ3 --model anthropic/claude-3.5-sonnet",
    "eval:cuda": "python scripts/eval/cuda_batch.py --model meta-llama/Llama-3.1-8B-Instruct",
    "eval:cuda:compare": "python scripts/eval/cuda_batch.py --models meta-llama/Llama-3.1-8B-Instruct speakleash/Bielik-7B-Instruct-v0.1",
    "eval:ts": "npx tsx scripts/eval/runner.ts",
    "eval:ts:remote": "npx tsx scripts/eval/runner.ts --url https://polish-academic-mcp.kolpol25.workers.dev/mcp",
    "d1:migrate:local": "wrangler d1 migrations apply polish-academic-eval-log --local",
    "d1:migrate:remote": "wrangler d1 migrations apply polish-academic-eval-log --remote"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@opentelemetry/api": "^1.9.0",
    "agents": "^0.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@openrouter/ai-sdk-provider": "^0.4.0",
    "@types/node": "^22.19.15",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.0",
    "oxlint": "^1.57.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
