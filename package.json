{
  "name": "polish-academic-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "lint": "oxlint src/",
    "lint:fix": "oxlint src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval": "npx tsx scripts/eval/runner.ts",
    "eval:rq1": "npx tsx scripts/eval/runner.ts --rq RQ1",
    "eval:rq2": "npx tsx scripts/eval/runner.ts --rq RQ2",
    "eval:rq3": "npx tsx scripts/eval/runner.ts --rq RQ3",
    "eval:rq4": "npx tsx scripts/eval/runner.ts --rq RQ4",
    "eval:local": "cross-env MCP_SERVER_URL=http://localhost:8787/mcp npx tsx scripts/eval/runner.ts",
    "eval:remote": "npx tsx scripts/eval/runner.ts --url https://polish-academic-mcp.kolpol25.workers.dev/mcp"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@opentelemetry/api": "^1.9.0",
    "agents": "^0.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@openrouter/ai-sdk-provider": "^0.4.0",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.0",
    "oxlint": "^1.57.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
