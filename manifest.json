{
  "manifest_version": "0.3",
  "name": "polish-academic-mcp",
  "display_name": "Polish Academic MCP",
  "version": "1.0.1",
  "description": "Local MCP server for Polish academic, public, and cultural data sources.",
  "author": {
    "name": "Polish Academic MCP maintainers"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "poland",
    "academia",
    "research",
    "bibliography"
  ],
  "tools_generated": true,
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"]
    }
  },
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"],
    "runtimes": {
      "node": ">=18.0.0"
    }
  }
}