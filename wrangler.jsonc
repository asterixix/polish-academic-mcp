{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "polish-academic-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"keep_vars": true,
	"kv_namespaces": [
		{
			"binding": "CACHE_KV",
			"id": "3a65887199da444388b42a88ee993376",
			"preview_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
		},
		{
			"binding": "RATE_LIMIT_KV",
			"id": "c24afe24902a4d549dee309557d42cd1",
			"preview_id": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
		},
		{
			"binding": "TOKEN_REGISTRY_KV",
			"id": "af815b2723bd4e4abf45adfe5a1340ba",
			"preview_id": "cccccccccccccccccccccccccccccccc",
		},
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
	},
	"vars": {
		"BDL_CLIENT_ID": "b73ca2b3-5546-49ee-f13c-08de8cb1a98a"
	},
	// Replace database_id with output of: npx wrangler d1 create polish-academic-eval-log
	// Then: npx wrangler d1 migrations apply polish-academic-eval-log --remote
	"d1_databases": [
		{
			"binding": "polish_academic_eval_log",
			"database_name": "polish-academic-eval-log",
			"database_id": "cba0000d-164e-42f7-9b79-c1237b95be2c",
			"remote": true
		}
	],
}