{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "polish-academic-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "CACHE_KV",
      "id": "3a65887199da444388b42a88ee993376",
      "preview_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    },
    {
      "binding": "RATE_LIMIT_KV",
      "id": "c24afe24902a4d549dee309557d42cd1",
      "preview_id": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    },
    {
      "binding": "TOKEN_REGISTRY_KV",
      "id": "af815b2723bd4e4abf45adfe5a1340ba",
      "preview_id": "cccccccccccccccccccccccccccccccc",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    // Upload MCP tool-call evaluation data to Nextcloud via WebDAV.
    // Set EVAL_WEBDAV_ENABLED=true and provide WebDAV credentials.
    "NEXTCLOUD_WEBDAV_BASE_URL": "https://nx85370.your-storageshare.de/f/1028079",
    // Optional folder/prefix inside the WebDAV share.
    "NEXTCLOUD_WEBDAV_PATH_PREFIX": "mcp-eval",
    // Best-effort cap to keep JSON payload bounded.
    "EVAL_WEBDAV_MAX_JSON_BYTES": "120000",
  }
}
