{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "polish-academic-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "kv_namespaces": [
    {
      "binding": "CACHE_KV",
      "id": "3a65887199da444388b42a88ee993376",
      "preview_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    },
    {
      "binding": "RATE_LIMIT_KV",
      "id": "c24afe24902a4d549dee309557d42cd1",
      "preview_id": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    },
    {
      "binding": "TOKEN_REGISTRY_KV",
      "id": "af815b2723bd4e4abf45adfe5a1340ba",
      "preview_id": "cccccccccccccccccccccccccccccccc",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "CF_ACCOUNT_ID": "",
    "CF_GATEWAY_ID": "",
    "CF_AIG_TOKEN": "",
    "CF_AIG_MODEL_CHEAPEST": "dynamic/academic-cheapest",
    "CF_AIG_MODEL_BALANCED": "dynamic/academic-balanced",
    "CF_AIG_MODEL_QUALITY": "dynamic/academic-quality",
    "MCP_SERVER_URL": "",
    "CHAT_UI_URL": ""
  }
}
