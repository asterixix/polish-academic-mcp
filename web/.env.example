# Cloudflare AI Gateway (compat endpoint)
CF_ACCOUNT_ID=
CF_GATEWAY_ID=
CF_AIG_TOKEN=

# Dynamic route aliases in AI Gateway
CF_AIG_MODEL_CHEAPEST=dynamic/academic-cheapest
CF_AIG_MODEL_BALANCED=dynamic/academic-balanced
CF_AIG_MODEL_QUALITY=dynamic/academic-quality

# MCP server exposed by your Worker
MCP_SERVER_URL=http://localhost:8788/mcp

# Optional: call Worker /chat directly from the browser transport.
# If empty, frontend falls back to local Next.js /api/chat.
# NEXT_PUBLIC_WORKER_CHAT_URL=http://localhost:8788/chat
